{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dict:seed": "tsx scripts/seed-sample-dict.ts public",
    "dict:index": "tsx scripts/build-search-index.ts public",
    "dict:compile": "tsx scripts/compile-dict.ts",
    "books:compile": "tsx scripts/compile-books.ts",
    "content:validate": "tsx scripts/validate-content.ts public",
    "content:freshness": "tsx scripts/check-freshness.ts public 365",
    "quality-gate": "tsx scripts/quality-gate.ts",
    "bundle:size": "tsx scripts/check-bundle-size.ts",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "prepare": "husky",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "ai": "^7.0.37",
    "dexie": "^4.4.4",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ts-fsrs": "^4.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.2",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.0",
      "postcss": "^8.5.18",
      "minimatch": "^10.2.6",
      "brace-expansion": "^5.0.8"
    }
  }
}
